<?xml version="1.0" encoding="utf-8"?>
<!-- C16 configuration -->
<config name="C16Nano" version="0">
  <actions>
    <!-- the init action is being executed immediately -->
    <!-- when this file has been loaded -->
    <action name="init">
      <!-- (try to) load config from sd card -->
      <load file="C16.ini"/>
      <set id="R" value="3"/>  <!-- keep machine in cold reset -->
      <set id="Z" value="1"/>  <!-- default c1541 -->
      <set id="F" value="0"/>  <!-- default cartridge detach -->
    </action>
    
    <!-- the ready action is being executed once all -->
    <!-- initialization has been done -->
    <action name="ready">
      <set id="R" value="0"/>  <!-- release reset -->
      <set id="Z" value="0"/>  <!-- default c1541 -->
    </action>
      
    <action name="save">
      <!-- save config to sd card -->
      <save file="C16.ini"/>
    </action>
      
    <action name="reset">
      <!-- trigger a system reset -->
      <set id="R" value="1"/>
      <delay ms="10"/>
      <set id="R" value="0"/>      
    </action>
    
    <action name="reset_hide">
      <!-- trigger a system reset and hide OSD -->
      <link action="reset"/>
      <hide/>      
    </action>      

    <action name="cold_reset">
      <!-- trigger a cold system reset -->
      <set id="R" value="3"/>
      <delay ms="10"/>
      <set id="R" value="0"/>      
    </action>
    
    <action name="cold_reset_hide">
      <!-- trigger a cold reset and hide OSD -->
      <link action="cold_reset"/>
      <hide/>      
    </action>

    <action name="c1541_reset">
      <!-- trigger a cold system reset -->
      <set id="Z" value="1"/>
      <delay ms="10"/>
      <set id="Z" value="0"/>
    </action>

    <action name="c1541_reset_hide">
      <!-- trigger a c1541 reset and hide OSD -->
      <link action="c1541_reset"/>
      <hide/>      
    </action>

    <action name="detach_reset">
      <!-- trigger a detach reset -->
      <set id="F" value="1"/>
      <delay ms="10"/>
      <set id="F" value="0"/>
    </action>

    <action name="detach_reset_hide">
      <!-- trigger a detach reset and hide OSD -->
      <link action="detach_reset"/>
      <hide/>      
    </action>

  </actions>
  
  <menu label="C16Nano">
 <button label="Detach Cartridge &amp; Reset" action="detach_reset_hide"/>
    <menu label="System">
      <list label="Joyport 1:" id="Q" default="2">
 <listentry label="Retro D9 1" value="0"/>
 <listentry label="Retro D9 2" value="1"/>
 <listentry label="USB Joy 1" value="2"/>
 <listentry label="USB Joy 2" value="3"/>
 <listentry label="NumPad" value="4"/>
 <listentry label="Off" value="5"/>
      </list>
      <list label="Joyport 2:" id="J" default="5">
 <listentry label="Retro D9 1" value="0"/>
 <listentry label="Retro D9 2" value="1"/>
 <listentry label="USB Joy 1" value="2"/>
 <listentry label="USB Joy 2" value="3"/>
 <listentry label="NumPad" value="4"/>
 <listentry label="Off" value="5"/>
      </list>
      <list label="Swap Joyst:" id="M" default="0">
 <listentry label="Off" value="0"/>
 <listentry label="On" value="1"/>
      </list>
      <list label="C1541 ROM:" id="D" default="1" action="c1541_reset">
 <listentry label="Dolphin" value="0"/>
 <listentry label="CBM DOS" value="1"/>
 <listentry label="Speed DOS P" value="2"/>
 <listentry label="Jiffy DOS" value="3"/>
      </list>
      <list label="TV Standard:" id="<" default="0">
 <listentry label="from Kernal" value="0"/>
 <listentry label="Force PAL" value="1"/>
 <listentry label="Force NTSC" value="2"/>
      </list>
      <list label="Model:" id="N" default="1">
 <listentry label="C16" value="0"/>
 <listentry label="Plus/4" value="1"/>
      </list>
      <list label="Tape Sound:" id="I" default="1">
 <listentry label="Off" value="0"/>
 <listentry label="On" value="1"/>
      </list>
      <list label="RS232 port:" id="*" default="0">
 <listentry label="Tang USB-C" value="0"/>
 <listentry label="External" value="1"/>
 <listentry label="reserved" value="2"/>
      </list>
      <list label="Internal IEC:" id="3" default="0">
 <listentry label="8" value="0"/>
 <listentry label="9" value="1"/>
 <listentry label="10" value="2"/>
 <listentry label="11" value="3"/>
      </list>
      <list label="External IEC:" id="2" default="0" action="c1541_reset_hide">
 <listentry label="Off" value="0"/>
 <listentry label="D9 #1" value="1"/>
 <listentry label="D9 #2/spare" value="2"/>
      </list>
      <list label="Run PRG:" id="5" default="1">
 <listentry label="Off" value="0"/>
 <listentry label="On" value="1"/>
      </list>
      <list label="SID:" id="O" default="0">
 <listentry label="6581" value="0"/>
 <listentry label="8580" value="1"/>
      </list>
      <list label="SID Digifix:" id="U" default="0">
 <listentry label="Off" value="0"/>
 <listentry label="On" value="1"/>
      </list>
      <list label="SID card:" id="K" default="0">
 <listentry label="Off" value="0"/>
 <listentry label="On" value="1"/>
      </list>
      <list label="SID Card Mode:" id="#" default="0">
 <listentry label="Plus/4" value="0"/>
 <listentry label="C64" value="1"/>
      </list>
      <list label="SID Ports:" id="6" default="0">
 <listentry label="Mirror" value="0"/>
 <listentry label="Split" value="1"/>
      </list>
      <list label="SID Filter:" id="H" default="0">
 <listentry label="Default" value="0"/>
 <listentry label="Custom 1" value="1"/>
 <listentry label="Custom 2" value="2"/>
 <listentry label="Custom 3" value="3"/>
 <listentry label="Adjustable" value="4"/>
      </list>
      <list label="SID Fc Ofs:" id=">" default="0">
 <listentry label="0" value="0"/>
 <listentry label="1" value="1"/>
 <listentry label="2" value="2"/>
 <listentry label="3" value="3"/>
 <listentry label="4" value="4"/>
 <listentry label="5" value="5"/>
      </list>
 <button label="C1541 Reset" action="c1541_reset_hide"/>
 <button label="Cold Boot" action="cold_reset_hide"/>
    </menu>
    <menu label="Storage">
      <fileselector label="Floppy 8:" ext="d64;g64" index="0" default="disk8.d64"/>
      <fileselector label="CRT ROM:" ext="bin" index="1"/>
      <fileselector label="PRG BASIC:" ext="prg" index="2"/>
      <fileselector label="BIN KERNAL:" ext="bin" index="3"/>
      <fileselector label="TAP TAPE:" ext="tap" index="4"/> 
      <fileselector label="Function ROM:" ext="bin" index="5"/>
      <list label="Disk prot.:" id="P" default="0">
	<listentry label="None" value="0"/>
	<listentry label="8:" value="1"/>
      </list>
    </menu>
    <menu label="Settings">
      <list label="Screen:" id="W" default="0">
	<listentry label="Standard" value="0"/>
	<listentry label="Overscan" value="1"/>
	<listentry label="Wide" value="2"/>
      </list>
      <list label="Scanlines:" id="S" default="0">
	<listentry label="None" value="0"/>
	<listentry label="25%" value="1"/>
	<listentry label="50%" value="2"/>
	<listentry label="75%" value="3"/>
      </list>
      <list label="Volume:" id="A" default="2">
	<listentry label="Mute" value="0"/>
     <listentry label="25%" value="1"/>
     <listentry label="50%" value="2"/>
     <listentry label="75%" value="3"/>
     <listentry label="100%" value="4"/>
      </list>
      <button label="Save settings" action="save"/>
    </menu>
    <button label="Reset" action="reset_hide"/>
  </menu>    
</config>
